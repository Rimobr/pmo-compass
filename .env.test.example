# Copie para .env.test (gitignored) e preencha com valores reais.
# Ver tests/e2e/README.md para como criar as 3 contas de QA.

SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxx

TEST_ADMIN_EMAIL=qa.admin@pmo-compass-test.local
TEST_ADMIN_PASSWORD=

TEST_GERENTE_EMAIL=qa.gerente@pmo-compass-test.local
TEST_GERENTE_PASSWORD=

TEST_CONSULTA_EMAIL=qa.consulta@pmo-compass-test.local
TEST_CONSULTA_PASSWORD=

# Um projeto real (id do seletor do app, ex: 'nexus') ao qual qa.gerente TEM acesso.
TEST_PROJECT_WITH_GRANT_ID=nexus
# Um projeto real ao qual qa.consulta e qa.gerente NÃO têm acesso — usado pro teste
# negativo de RLS (CT01: RLS deve bloquear, não a UI).
TEST_PROJECT_WITHOUT_GRANT_ID=valdori

# Opcional — se já tiver um servidor rodando (ex: produção), aponte pra ele em vez de
# subir um local via `npx serve`.
# APP_BASE_URL=https://pmo-compass.vercel.app
