{
  "name": "pmo-compass",
  "version": "2.113.11",
  "private": true,
  "scripts": {
    "test:unit": "node tests/run.js && node --test tests/unit/*.test.mjs",
    "test:smoke": "node tests/smoke/empty-project.mjs",
    "test:a11y": "node tests/smoke/screens-a11y.mjs",
    "data-map": "node scripts/build-data-map.mjs",
    "test:e2e": "playwright test",
    "check:sql": "node scripts/check-sql.mjs",
    "check:db": "node scripts/check-db-hardening.mjs",
    "check:schema": "node scripts/build-schema.mjs --check",
    "check:facts": "node scripts/sync-facts-client.mjs --check",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint .",
    "check:version": "node scripts/check-version.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "changelog": "node scripts/build-changelog.mjs",
    "build:public": "node scripts/build-public.mjs",
    "build:intel": "node scripts/build-intel.mjs",
    "check:public-build": "node scripts/build-public.mjs --check",
    "check:vendor": "node scripts/vendor-libs.mjs --check",
    "test:dist": "node tests/smoke/dist-boot.mjs",
    "test:xss": "node tests/smoke/xss.mjs",
    "test:kind": "node tests/smoke/kind-filter.mjs",
    "vendor:libs": "node scripts/vendor-libs.mjs",
    "audit:db": "node scripts/audit-db.mjs",
    "check:intel": "node scripts/build-intel.mjs --check",
    "check:all": "npm run lint && npm run check:version && npm run check:secrets && npm run check:vendor && npm run check:intel && npm run check:public-build && npm run check:sql && npm run check:schema && npm run test:unit && npm run test:smoke && npm run test:dist && npm run test:xss && npm run test:kind && npm run test:a11y",
    "test:ciclo": "node tests/ciclo/ciclo-regras-navegador.mjs",
    "test:ciclo-db": "node tests/ciclo/ciclo-regras-banco.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@libpg-query/parser": "^17.6.10",
    "@playwright/test": "^1.48.0",
    "@supabase/supabase-js": "^2.46.1",
    "dotenv": "^16.4.5",
    "esbuild": "^0.24.2",
    "eslint": "^9.39.5",
    "eslint-plugin-html": "^8.2.1",
    "serve": "^14.2.0"
  }
}
