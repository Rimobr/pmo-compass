{
  "name": "pmo-compass",
  "version": "2.64.0",
  "private": true,
  "scripts": {
    "test:unit": "node tests/run.js && node --test tests/unit/*.test.mjs",
    "test:smoke": "node tests/smoke/empty-project.mjs",
    "test:a11y": "node tests/smoke/screens-a11y.mjs",
    "data-map": "node scripts/build-data-map.mjs",
    "test:e2e": "playwright test",
    "check:sql": "node scripts/check-sql.mjs",
    "check:db": "node scripts/check-db-hardening.mjs",
    "check:schema": "node scripts/build-schema.mjs --check",
    "check:facts": "node scripts/sync-facts-client.mjs --check",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint .",
    "check:version": "node scripts/check-version.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "changelog": "node scripts/build-changelog.mjs",
    "check:all": "npm run lint && npm run check:version && npm run check:secrets && npm run check:sql && npm run check:schema && npm run test:unit && npm run test:smoke && npm run test:a11y"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@libpg-query/parser": "^17.6.10",
    "@playwright/test": "^1.48.0",
    "@supabase/supabase-js": "^2.46.1",
    "dotenv": "^16.4.5",
    "eslint": "^9.39.5",
    "eslint-plugin-html": "^8.2.1",
    "serve": "^14.2.0"
  }
}
